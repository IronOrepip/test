# Names only. Never put real values in a committed file.
# Local development (`npm run dev`) needs none of these: it uses local stand-ins.
# On Cloudflare, set each one with:  npx wrangler secret put NAME --env staging

# Stripe (test-mode keys on staging: sk_test_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: pin the Stripe API version
STRIPE_API_VERSION=

# Supabase (EU region, Frankfurt)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email provider (Resend)
RESEND_API_KEY=

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Staging password gate
STAGING_USERNAME=
STAGING_PASSWORD=

# Phase 2
BREVO_API_KEY=
LINK_SIGNING_SECRET=
RU_SHOP_ID=
RU_SECRET_KEY=

# Plain settings (not secret) live in wrangler.toml: ENVIRONMENT, SHOP_LIVE, SITE_URL, ADMIN_REQUIRE_MFA
